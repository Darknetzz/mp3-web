# Optional. Copy to .env; loaded by vlucas/phpdotenv in _includes.php. Real environment
# variables (docker run -e ...) win over this file.
APP_NAME = "mp3-web"                               # not read by the code
AUTHOR   = "<your name>"                           # not read by the code
URL      = "https://github.com/Darknetzz/mp3-web"  # link on the version label in the header
ENV      = "prod"                                  # behaviour is set by the "env" setting
VERSION  = "vX.Y.Z"                                # shown next to the site title

# Accounts (all optional)
# AUTH_REQUIRED  = "true"       # false: no sign-in, everyone acts as the first admin
# ADMIN_USERNAME = "admin"      # with ADMIN_PASSWORD: create this admin on first start, skip setup
# ADMIN_PASSWORD = ""
# MUSIC_FOLDERS  = "music"      # with ADMIN_*: music folders, ":"-separated ("path!" = no subfolders)
# SITE_TITLE     = "Music Player"
# SETUP_TOKEN    = ""           # the setup screen asks for this value
# DATA_DIR       = "data"       # where mp3web.sqlite (accounts) is kept
