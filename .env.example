# Copy to .env. Loaded by vlucas/phpdotenv in _includes.php; the app won't start without .env.
APP_NAME = "mp3-web"                               # not read by the code
AUTHOR   = "<your name>"                           # not read by the code
URL      = "https://github.com/Darknetzz/mp3-web"  # link on the version label in the header
ENV      = "prod"                                  # required, but behaviour is set by the "env" setting
VERSION  = "vX.Y.Z"                                # required, shown next to the site title
